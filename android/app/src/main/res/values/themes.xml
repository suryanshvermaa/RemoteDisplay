<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Follows the phone's light / dark setting (DayNight), with the RemoteDisplay colours. -->
    <style name="Theme.RemoteDisplay" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/rd_primary</item>
        <item name="colorOnPrimary">@color/rd_on_primary</item>
        <item name="colorPrimaryContainer">@color/rd_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/rd_on_primary_container</item>
        <item name="android:colorBackground">@color/rd_background</item>
        <item name="colorSurface">@color/rd_surface</item>
        <item name="colorSurfaceVariant">@color/rd_surface_variant</item>
        <item name="colorOnSurface">@color/rd_on_surface</item>
        <item name="colorOnSurfaceVariant">@color/rd_on_surface_variant</item>
        <item name="colorOutline">@color/rd_outline</item>
        <item name="colorError">@color/rd_error</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- The viewer is always dark, so the remote screen stands out. -->
    <style name="Theme.RemoteDisplay.Viewer" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">#818CF8</item>
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
    </style>

    <style name="RdCard" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">?attr/colorSurface</item>
        <item name="strokeColor">?attr/colorOutline</item>
        <item name="cardCornerRadius">20dp</item>
        <item name="contentPadding">20dp</item>
    </style>

    <style name="RdSection" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.08</item>
    </style>

    <style name="RdToolButton" parent="Widget.Material3.Button.TonalButton">
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:layout_marginStart">4dp</item>
        <item name="android:layout_marginEnd">4dp</item>
    </style>
</resources>
