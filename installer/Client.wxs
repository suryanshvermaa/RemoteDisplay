<?xml version="1.0" encoding="UTF-8"?>
<!--
  RemoteDisplay Client installer (WiX 3.14 schema; built by Build-Client.ps1 with candle and light).

  Installs only the viewer, RemoteDisplayClient.exe, with a Start menu shortcut. It has no host, service,
  driver or firewall parts, so a PC that only views a shared screen needs nothing else.

  Updates install over the old version (MajorUpgrade), so installing a new build does not mean removing the
  old one first. Uninstall removes the program; the saved recent computers and device key in
  %APPDATA%\RemoteDisplay are left alone.
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*"
           Name="RemoteDisplay Client"
           Language="1033"
           Version="1.0.0.0"
           Manufacturer="RemoteDisplay"
           UpgradeCode="88A8D52B-145C-4C37-93A2-5CB300FAB340">
    <Package InstallerVersion="500" Compressed="yes" InstallScope="perMachine" Description="RemoteDisplay Client installer" />
    <MajorUpgrade DowngradeErrorMessage="A newer version of RemoteDisplay Client is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Feature Id="Main" Title="RemoteDisplay Client" Level="1">
      <ComponentGroupRef Id="ClientFiles" />
      <ComponentRef Id="ClientStartMenuShortcut" />
    </Feature>

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="RemoteDisplay Client" />
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Component Id="ClientStartMenuShortcut" Guid="C9B29803-BB1B-494F-83BB-8F44413C6983">
          <Shortcut Id="ClientShortcut"
                    Name="RemoteDisplay Client"
                    Description="View a computer that is sharing its screen"
                    Target="[INSTALLFOLDER]RemoteDisplayClient.exe"
                    WorkingDirectory="INSTALLFOLDER" />
          <RegistryValue Root="HKCU" Key="Software\RemoteDisplayClient" Name="ShortcutInstalled" Type="integer" Value="1" KeyPath="yes" />
        </Component>
      </Directory>
    </Directory>

    <ComponentGroup Id="ClientFiles" Directory="INSTALLFOLDER">
      <Component Id="ClientExeComponent" Guid="822B47A4-F08C-4273-A3EF-632974C806DF">
        <File Id="ClientExe" Source="$(var.StageDir)\RemoteDisplayClient.exe" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Product>
</Wix>
